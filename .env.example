# Shopify App Credentials (Client ID and Client Secret from Shopify Partner Dashboard)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Public application base URL (e.g. https://podesk-purchase-orders.vercel.app)
SHOPIFY_APP_URL=

# Shopify API Scopes
SCOPES=read_products,read_inventory,read_locations,read_orders

# Managed PostgreSQL Connection String
DATABASE_URL="postgresql://user:password@host:5432/podesk_production?sslmode=require"

# Environment Mode (development | production)
NODE_ENV=production
